<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="960.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controllers.BooksController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Library Catalogue" styleClass="header-title"/>
            <HBox spacing="10.0">
                <Label text="Search:"/>
                <TextField fx:id="searchField"
                           promptText="Search by title, author, ISBN or genre"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Clear" onAction="#onClearSearch"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="book-scroll-pane">
            <content>
                <javafx.scene.layout.FlowPane fx:id="booksContainer" hgap="20" vgap="20" styleClass="book-grid">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                </javafx.scene.layout.FlowPane>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <VBox spacing="12.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Add / Edit Book" styleClass="section-title"/>
            <GridPane hgap="12.0" vgap="10.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="30"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="30"/>
                    <RowConstraints minHeight="30"/>
                    <RowConstraints minHeight="30"/>
                    <RowConstraints minHeight="30"/>
                </rowConstraints>

                <Label text="Title" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="titleField" promptText="Title"
                           GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Author" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <TextField fx:id="authorField" promptText="Author"
                           GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="ISBN" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="isbnField" promptText="ISBN"
                           GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Genre" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <TextField fx:id="genreField" promptText="Genre"
                           GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Publisher" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="publisherField" promptText="Publisher"
                           GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Pages" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <TextField fx:id="pagesField" promptText="Number of pages"
                           GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Publication Date" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <DatePicker fx:id="publicationDatePicker"
                            GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Notes" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <TextArea fx:id="notesArea" promptText="Optional notes" prefRowCount="2"
                          GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="Clear Form" onAction="#onClearForm"/>
                <Button text="Save Book" onAction="#onAddBook" defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

