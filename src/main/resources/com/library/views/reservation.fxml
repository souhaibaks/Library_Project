<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="960.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.library.controllers.ReservationController">
    <top>
        <VBox spacing="8" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label text="Reservations" styleClass="header-title"/>
            <HBox spacing="10">
                <Label text="Search:"/>
                <TextField fx:id="searchField" promptText="Search by patron, item or status" HBox.hgrow="ALWAYS"/>
                <Button text="Clear" onAction="#onClearSearch"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TableView fx:id="reservationsTable" prefHeight="360.0">
            <columns>
                <TableColumn fx:id="reservationIdColumn" text="ID" prefWidth="70"/>
                <TableColumn fx:id="userColumn" text="Patron" prefWidth="160"/>
                <TableColumn fx:id="contactColumn" text="Email" prefWidth="180"/>
                <TableColumn fx:id="itemColumn" text="Item" prefWidth="190"/>
                <TableColumn fx:id="reservedColumn" text="Reserved" prefWidth="110"/>
                <TableColumn fx:id="dueColumn" text="Due" prefWidth="110"/>
                <TableColumn fx:id="returnColumn" text="Returned" prefWidth="110"/>
                <TableColumn fx:id="statusColumn" text="Status" prefWidth="120"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="12" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Label text="Create / Update Reservation" styleClass="section-title"/>
            <GridPane hgap="12" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="30"/>
                    <ColumnConstraints percentWidth="20"/>
                    <ColumnConstraints percentWidth="30"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints minHeight="35"/>
                    <RowConstraints minHeight="35"/>
                    <RowConstraints minHeight="35"/>
                    <RowConstraints minHeight="35"/>
                </rowConstraints>

                <Label text="Patron" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <ComboBox fx:id="userPicker" promptText="Select patron"
                          GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                <Label text="Item" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <ComboBox fx:id="itemPicker" promptText="Select item"
                          GridPane.columnIndex="3" GridPane.rowIndex="0"/>

                <Label text="Reservation Date" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <DatePicker fx:id="reservationDatePicker"
                            GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                <Label text="Due Date" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <DatePicker fx:id="dueDatePicker"
                            GridPane.columnIndex="3" GridPane.rowIndex="1"/>

                <Label text="Return Date" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <DatePicker fx:id="returnDatePicker"
                            GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                <Label text="Status" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <ComboBox fx:id="statusPicker" promptText="Auto"
                          GridPane.columnIndex="3" GridPane.rowIndex="2"/>

                <Label text="Notes" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextArea fx:id="notesArea" promptText="Optional notes"
                          prefRowCount="2"
                          GridPane.columnIndex="1" GridPane.rowIndex="3"
                          GridPane.columnSpan="3"/>
            </GridPane>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button text="Clear Form" onAction="#onClearForm"/>
                <Button text="Mark Returned" onAction="#onMarkReturned"/>
                <Button text="Save Reservation" onAction="#onAddReservation" defaultButton="true"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

