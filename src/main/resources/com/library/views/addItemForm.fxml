<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>
    <Label text="Add / Edit Item" styleClass="section-title"/>
    <GridPane hgap="12.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="30"/>
            <RowConstraints minHeight="30"/>
            <RowConstraints minHeight="30"/>
            <RowConstraints minHeight="30"/>
            <RowConstraints minHeight="30"/>
        </rowConstraints>

        <Label text="Item Type" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="itemTypeComboBox" promptText="Select item type"
                   GridPane.columnIndex="1" GridPane.rowIndex="0"/>

        <Label text="Title" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
        <TextField fx:id="titleField" promptText="Title"
                   GridPane.columnIndex="3" GridPane.rowIndex="0"/>

        <Label text="Author" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <TextField fx:id="authorField" promptText="Author"
                   GridPane.columnIndex="1" GridPane.rowIndex="1"/>

        <Label text="ISBN" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
        <TextField fx:id="isbnField" promptText="ISBN"
                   GridPane.columnIndex="3" GridPane.rowIndex="1"/>

        <Label text="Publisher" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <TextField fx:id="publisherField" promptText="Publisher"
                   GridPane.columnIndex="1" GridPane.rowIndex="2"/>

        <Label text="Publication Date" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
        <DatePicker fx:id="publicationDatePicker"
                    GridPane.columnIndex="3" GridPane.rowIndex="2"/>

        <!-- Book-specific fields -->
        <Label text="Genre" fx:id="genreLabel" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <TextField fx:id="genreField" promptText="Genre"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>

        <Label text="Pages" fx:id="pagesLabel" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
        <TextField fx:id="pagesField" promptText="Number of pages"
                   GridPane.columnIndex="3" GridPane.rowIndex="3"/>

        <!-- Magazine-specific fields -->
        <Label text="Category" fx:id="categoryLabel" GridPane.columnIndex="0" GridPane.rowIndex="4" visible="false" managed="false"/>
        <TextField fx:id="categoryField" promptText="Category"
                   GridPane.columnIndex="1" GridPane.rowIndex="4" visible="false" managed="false"/>

        <Label text="Issue Number" fx:id="issueLabel" GridPane.columnIndex="2" GridPane.rowIndex="4" visible="false" managed="false"/>
        <TextField fx:id="issueField" promptText="Issue number"
                   GridPane.columnIndex="3" GridPane.rowIndex="4" visible="false" managed="false"/>

        <Label text="Notes" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
        <TextArea fx:id="notesArea" promptText="Optional notes" prefRowCount="2"
                  GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.columnSpan="3"/>
    </GridPane>
    <HBox alignment="CENTER_RIGHT" spacing="10.0">
        <Button text="Clear Form" onAction="#onClearForm"/>
        <Button text="Save Item" onAction="#onAddItem" defaultButton="true"/>
    </HBox>
</VBox>
